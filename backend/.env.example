# ==============================================================================
# DISCOSYNTH AI — BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Database Connection URI
# Local Development (SQLite):
DATABASE_URL=sqlite:///./discosynth.db

# Production Supabase PostgreSQL (Transaction Pooler - Port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth Configuration
# Copy from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]
# Optional Service Role Key for backend administration:
# SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# LLM Scenario Generation Engine ("mock" or "gemini")
LLM_PROVIDER=mock
GEMINI_API_KEY=

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.vercel.app
